---
/**
 * Deep Time — the only page (spec §4).
 *
 * Everything renders to HTML at build. No client-side templating: the copy is in
 * the document for a screen reader, for no-JS, and for `view-source`.
 *
 * Without JS this is the 55 arrivals in chronological order with their dates,
 * names and lines, then the withheld ten. It loses the scale illusion and keeps
 * every fact — which is exactly what the no-JS path is specified to do. The
 * runtime adds `.js` to <html> and only then does the document become the
 * fixed-overlay instrument.
 *
 * THE LAYER SPLIT is the one architectural ruling (§3): the canvas draws the
 * field and nothing else. Anything carrying text or art is DOM, absolutely
 * positioned, driven by `transform` and `opacity` only.
 */
import '@fontsource-variable/archivo';
import {
  arrivals,
  arrivalY,
  CONSTANTS,
  emphasise,
  fanDate,
  fanRows,
  FINALE_CFG,
  flood,
  milestones,
  plain,
  PLATE_CFG,
  pxFromNow,
  spokenDate,
  spokenName,
  withheld,
} from '../lib/timeline.ts';
import art from '../data/art.json' with { type: 'json' };

const { RUN, YEARS_PER_PX, TOTAL, EARTH_AGE } = CONSTANTS;
type ArtEntry = (typeof art)[keyof typeof art];
const artFor = (id: string): ArtEntry | undefined => (art as Record<string, ArtEntry>)[id];
/** The record register (§11) — baked under its own `record/` key so it can never
    collide with a scroll subject's painted plate. Missing art is a build failure. */
const recordArt = (id: string): ArtEntry => (art as Record<string, ArtEntry>)[`record/${id}`]!;
const nf = (n: number) => n.toLocaleString('en-US');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deep Time — the whole history of Earth, at true scale</title>
    <meta
      name="description"
      content={`The whole history of Earth on one linear scroll. This page is ${nf(RUN)} pixels tall. One pixel is ${nf(YEARS_PER_PX)} years. The scale never changes.`}
    />
    <meta name="color-scheme" content="dark" />

    {/* The mark is the true-scale bar itself — an SVG, so it costs one request
        and no raster set. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* THE SHARE ARTIFACT (§9), rebuilt 2026-08-07.

        It was a capture of the finale, which put ALL OF HUMAN HISTORY on every
        link to this page — and people arrived expecting a page about human
        history. It is the opposite: 114,825 of the 115,000 pixels pass before
        humans exist, and that line is the last beat, not the subject. The line
        stays at the end where it earns itself; the card is now composed by
        `scripts/make-og.ts` (`npm run og`) from this page's own wordmark, scale
        constants and arrival positions, and carries the dustincoledata mark.

        Still committed rather than built per-request: it is fetched by crawlers
        only, so it is outside §12's art budget. Re-run the script if the
        wordmark, the scale contract or the strip's subjects change. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Deep Time — the whole history of Earth, at true scale" />
    <meta property="og:description" content={plain(FINALE_CFG.copy.closing)} />
    <meta property="og:image" content="https://deeptime.dustincoledata.com/og.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Deep Time — the whole history of Earth, at true scale." />
    <meta property="og:url" content="https://deeptime.dustincoledata.com/" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <h1 class="sr-only">Deep Time</h1>

    {/* §10, fixed point one: where the scale argument is said out loud. */}
    <p class="sr-only">
      The whole history of Earth at true scale. This page is {nf(RUN)} pixels tall. One pixel is{' '}
      {nf(YEARS_PER_PX)} years. The scale never changes, anywhere, including at the end. What follows is{' '}
      {arrivals.length} arrivals in chronological order, from {arrivals[0]!.date} to{' '}
      {arrivals[arrivals.length - 1]!.date}. Ten more recent moments are listed at the end instead: they are
      too close together to be drawn on this page at all. Left and right arrow keys move between arrivals.
    </p>

    {/* THE TEXT-SCALE PROBE. layout.ts solves every box from a modelled type
        size, and a text-only zoom (Firefox) multiplies the rendered size of px
        type without moving the viewport — so the model has to be TOLD, or its
        whole 200% half is unreachable. `relayout()` reads this one element's
        rendered size and divides. The size is inline so no stylesheet can move
        it, and it is the one element on the page whose font-size is content.

        It carries a glyph so it has a BOX, which is the other half: a text-only
        zoom fires no event of its own, so the probe's own resize is the signal
        that the type changed under a viewport that did not. */}
    <span id="text-probe" style="font-size:16px" aria-hidden="true">M</span>

    <canvas id="field" aria-hidden="true"></canvas>

    {/* The held frame. All the words go here, read at the visitor's own pace. */}
    <div id="intro" aria-hidden="true">
      <div class="in">
        <p class="wordmark">Deep Time</p>
        <p class="thesis">The whole history of Earth, at true scale.</p>
        <ul class="facts">
          <li>This page is {nf(RUN)} pixels tall.</li>
          <li>One pixel is {nf(YEARS_PER_PX)} years.</li>
          <li>The scale never changes.</li>
          <li>Humans appear in the last 175 of them.</li>
        </ul>
        <p class="scroll">scroll</p>
      </div>
    </div>

    {/* The clock. aria-hidden in its entirety: it changes ~460 times and its px
        counter every frame — no announcement policy survives that (§10). */}
    <div id="hud" aria-hidden="true">
      {/* THE CLOCK SAYS THE WORDS (2026-08-07). It read "4.60 Ga" at a visitor
          who has never met the notation and nothing on the page expanded it.
          Number over unit, not "4.60 billion years ago" on one line: the flat
          form word-wraps to three lines at 200% (the words are long and the
          zone is 523 px), which took the phone's clock zone to 276 px against
          ruling F's 240 px floor — it would have bought plain English by
          taking pixels off the arrivals. Stacked, the only thing that wraps is
          a label that was always going to be small. */}
      <p id="hud-clock"><b id="hud-num">4.60</b><span id="hud-unit">billion years ago</span></p>
      <p id="hud-era">HADEAN</p>
      {/* THE COUNT, WITH EVERY ZERO (2026-08-09, Dustin: "somewhere I would
          like to have a little number that shows the number of years with all
          of the zeros. It counts down all the way to today"). It replaces the
          `0 / 115,000 px` readout rather than adding a row, because the HUD's
          footprint IS the reserved clock rect (§8) and the px counter is the
          one line the scale bar already says graphically. It sits ABOVE the
          rate line on purpose: "1 px = 40,000 years" directly beneath is what
          explains why the last four digits never move. */}
      <p id="hud-years">{nf(EARTH_AGE)} years</p>
      <p class="rate">1 px = {nf(YEARS_PER_PX)} years</p>
    </div>

    {/* The bar IS the scroll position — that identity is the point, and it is
        what makes the ending legible rather than arbitrary. */}
    <div id="bar" role="img" aria-label="True-scale bar: 0 percent of Earth's history passed.">
      <i class="track"></i>
      <i class="fill" id="bar-fill"></i>
      <i class="head" id="bar-head"></i>
      <span class="cap" aria-hidden="true">True scale</span>
    </div>

    <main>
      {
        arrivals.map((a) =>
          a.tier === 'F' ? (
            <p class="ar F" id={`a-${a.id}`} data-y={arrivalY(a)}>
              <span class="tx"><span class="n">{a.line}</span></span>
            </p>
          ) : (
            <figure class="ar" class:list={[a.tier]} id={`a-${a.id}`} data-y={arrivalY(a)}>
              {/* Only 3 of ~39 subjects have real art baked so far (§14) — most
                  boxes render text-only until the rest is generated. */}
              {artFor(a.id) && (
                <img
                  class="art"
                  src={artFor(a.id)!.file}
                  width={artFor(a.id)!.w}
                  height={artFor(a.id)!.h}
                  alt={artFor(a.id)!.alt}
                />
              )}
              <figcaption class="tx">
                <i class="rule"></i>
                <span class="d" aria-hidden="true">{a.date}</span>
                <span class="sr-only">{spokenDate(a.date!)}</span>
                <span class="n" aria-hidden="true" set:html={emphasise(a.name!)} />
                <span class="sr-only">{spokenName(a.name!)}</span>
                <span class="s" set:html={emphasise(a.line)} />
                {a.why && <span class="w" set:html={emphasise(a.why)} />}
              </figcaption>
            </figure>
          ),
        )
      }
    </main>

    {/* Named, and left empty on purpose. The counter is the only thing that moves.
        Every string comes from `PLATE_CFG` so the markup and `plateBox`'s model
        cannot describe different text — the rule `#blip-plate` has always followed,
        and the one this plate did not until ruling G (2026-08-06). */}
    <div id="plate" aria-hidden="true">
      <div class="in">
        <p class="kicker">{PLATE_CFG.kicker}</p>
        <p class="t">{PLATE_CFG.title}</p>
        <p class="sub">{PLATE_CFG.sub}</p>
        <p class="body" set:html={PLATE_CFG.body.join('<br />')} />
        <p class="cnt"><b id="plate-count">0</b><span id="plate-years"></span></p>
      </div>
    </div>

    {/* §10, fixed point two — without it, a list with nothing in it reads as a
        list that ended, and this stretch is the rehearsal for the payoff. */}
    <p class="sr-only">
      This stretch is 25,000 pixels long — a fifth of the page — and holds four arrivals. The longest gap
      between them is 15,000 pixels: 600 million years in which nothing on this page happens.
    </p>

    <section id="finale" inert>
      {/* §10, fixed point three. The visual convergence is deliberately NOT
          described: a sighted visitor is not told what the fan means either. */}
      <p class="sr-only">
        The ending. Everything below happened in the last 175 pixels of this page. The thirty moments you
        have passed are listed first, in order. Then ten more. Those ten are drawn nowhere on the page
        above, because at {nf(YEARS_PER_PX)} years to the pixel they all fall inside its final{' '}
        {pxFromNow(withheld[0]!)} pixels — and the last of them, everything humans have farmed, written,
        built or remembered, is three tenths of one pixel.
      </p>

      <svg id="leaders" aria-hidden="true"></svg>

      <p id="seam-caption" aria-hidden="true">{FINALE_CFG.copy.seamCaption}</p>

      <ol>
        {
          fanRows.map((r, i) => (
            <li data-fan-row={i} class:list={[r.ten && 'ten']}>
              <a href={`#a-${r.id}`}>
                <span class="fd" aria-hidden="true">{r.date}{r.contested && '*'}</span>
                <span class="sr-only">{spokenDate(r.date)}</span>
                <span class="fn">{r.name}</span>
              </a>
            </li>
          ))
        }
      </ol>

      {/* THE FLOOD (design §4) — the record, heaped. `aria-hidden` with empty
          `alt`s on purpose: the finale's visually-hidden summary above already
          states the whole scale argument in numbers, and fifty alt strings would
          be read out as a wall in front of it. Every rect comes from `blip()`;
          nothing here positions a print. */}
      <div id="blip" aria-hidden="true">
        {/* Two hairlines from the heap's outer right corners to the bar's last
            pixel. Decoration, like the leader lines — `blip()` gives the coords. */}
        <svg id="blip-bracket"><line /><line /></svg>
        {
          flood.map((f, i) => (
            <img
              class="bc"
              data-blip-cell={i}
              src={recordArt(f.id).file}
              alt=""
              width={recordArt(f.id).w}
              height={recordArt(f.id).h}
              loading="eager"
              decoding="async"
            />
          ))
        }
      </div>

      {/* THE PLATE (design §6) — one rect, its tenants in sequence, images never
          entering it. EVERY string comes from `FINALE_CFG.copy`: `blip()` solves
          the band's height from that same copy, so a title retyped here would
          silently leave the solved band and the rendered words describing
          different text. `plateTitle` is an array because the break between its
          two lines is authored, not wrapped. */}
      <div id="blip-plate">
        {/* TWO TENANTS, ONE SLOT. The left-holding beat swaps rather than adds, so
            `↑ again` takes the kicker's slot and the epilogue takes the line's —
            which is what lets the band be solved as a `max` and cost the heap
            nothing for the last beat. Sequential, never a crossfade. */}
        <div class="ptop">
          <p class="pk">{FINALE_CFG.copy.plateKicker}</p>
          <a class="again" href="#top">{FINALE_CFG.copy.again}</a>
        </div>
        <h2 class="pt" set:html={FINALE_CFG.copy.plateTitle.map(emphasise).join('<br />')} />
        <hr class="pr" />
        {/* The closing line lives HERE, in the band — one sentence, one
            measurement. The plate reuses this block rather than duplicating it. */}
        <div id="closing-block">
          <p class="closing">{FINALE_CFG.copy.closing}</p>
          {/* Refilled 2026-08-09 with the calendar-year comparison — see finaleNote in
              timeline.json for why it is this slot and not the closing line's. The guard
              stays: an empty string is a valid state and puts the ending back on the line. */}
          {FINALE_CFG.copy.epilogue && <p class="epilogue" set:html={emphasise(FINALE_CFG.copy.epilogue)} />}
        </div>
      </div>
    </section>

    {/* lvh, not vh — so the document never shrinks under a scrolled visitor when
        the URL bar reappears. Without the pad the last beats of the finale are
        unreachable on every device. */}
    {/* The dustincoledata signature. Bottom-RIGHT, not bottom-left: the HUD owns the
        left corner for the whole scroll, and the true-scale bar owns the right edge,
        so this is the one corner that is free at every scroll position. It clears
        the bar rather than sitting under it. */}
    <a class="dcd-mark" href="https://dustincoledata.com" target="_blank" rel="noopener"
       aria-label="A Dustin Cole Data project">
      <svg class="dcd-mark-logo" viewBox="3.8 17.1 56.5 29.8" aria-hidden="true" focusable="false">
        <g transform="translate(2.943 46.426) scale(0.040753 -0.040753)">
          <path fill="currentColor" d="M22 269Q22 388 88.5 468.0Q155 548 262 548Q345 548 408 488V718H579V0H422V61Q354 -10 262 -10Q155 -10 88.5 70.5Q22 151 22 269ZM200 269Q200 209 230.5 176.5Q261 144 303 144Q346 144 376.0 177.0Q406 210 406 270Q406 331 376.0 362.5Q346 394 303.0 394.0Q260 394 230.0 362.0Q200 330 200 269Z"/>
          <path fill="currentColor" transform="translate(605 0)" d="M293 -10Q173 -10 97.5 68.0Q22 146 22 269Q22 389 99.5 468.5Q177 548 293 548Q404 548 479.5 479.0Q555 410 566 298H384Q382 342 357.5 368.0Q333 394 294 394Q249 394 224.0 361.0Q199 328 199 269Q199 208 223.5 175.5Q248 143 294 143Q334 143 357.5 168.5Q381 194 384 240H566Q555 125 481.5 57.5Q408 -10 293 -10Z"/>
          <path class="dcd-mark-dot" transform="translate(1163 0)" d="M241 104Q241 56 211.0 25.5Q181 -5 133.0 -5.0Q85 -5 54.5 25.5Q24 56 24 104Q24 153 54.5 183.5Q85 214 133.0 214.0Q181 214 211.0 183.5Q241 153 241 104Z"/>
        </g>
      </svg>
      <i class="dcd-mark-rule" aria-hidden="true"></i>
      <span class="dcd-mark-words"><span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span></span>
    </a>

    <div class="spacer"></div>
    <div aria-live="polite" class="sr-only" id="announce"></div>

    <script>import '../scripts/main.ts';</script>
  </body>
</html>

<style is:global define:vars={{ total: `${TOTAL}px` }}>
  :root {
    --paper: #f4f1ea;
    --ink: #12161a;
    --face: 'Archivo Variable', ui-sans-serif, system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  html {
    /* Never smooth, for anybody. `↑ again` and every jump are instantaneous. */
    scroll-behavior: auto !important;
    background: #05070a;
  }

  body {
    margin: 0;
    font-family: var(--face);
    color: var(--paper);
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }

  /* Out of the flow and off the glass, but STILL RENDERED — `display: none` is
     what would make it unmeasurable. Its font-size is declared inline, never
     here, so this rule can never quietly change what the model measures. */
  #text-probe {
    position: absolute; top: 0; left: 0;
    visibility: hidden; pointer-events: none; white-space: pre;
  }

  /* ---------- no-JS: a plain chronological document ---------- */
  #field, #intro, #hud, #bar, #plate, .spacer { display: none; }
  main { max-width: 34rem; margin: 0 auto; padding: 3rem 1.25rem; }
  .ar { margin: 0 0 2.75rem; }
  .ar .rule { display: none; }
  .ar .d { display: block; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.6; }
  .ar .n { display: block; font-size: 1.35rem; font-weight: 650; letter-spacing: -0.02em; margin: 0.35rem 0; }
  .ar .s { display: block; opacity: 0.75; line-height: 1.55; }
  .ar .w { display: block; opacity: 0.62; line-height: 1.55; margin-top: 0.5rem; }
  .ar img.art { display: block; max-width: 100%; height: auto; margin-bottom: 0.75rem; border-radius: 3px; }
  #finale { max-width: 34rem; margin: 0 auto; padding: 0 1.25rem 6rem; }
  #leaders { display: none; }

  /* ---------- the instrument ---------- */
  .js #field, .js #intro, .js #hud, .js #bar, .js #plate, .js .spacer { display: block; }
  .js #leaders { display: block; }

  .js #field {
    position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0;
    display: block;
  }

  .js main {
    position: fixed; inset: 0; z-index: 2; pointer-events: none; max-width: none;
    margin: 0; padding: 0;
  }

  /* THE NO-COLLISION CONTRACT, in CSS. Every rect below is written by layout.ts;
     nothing here may position an arrival. An arrival is ONE box, text anchored to
     the bottom, art drawn into whatever height is left above it. */
  .js .ar {
    position: absolute; margin: 0; display: flex; align-items: flex-end;
    opacity: 0; will-change: transform, opacity;
  }
  .js .ar .tx { width: 100%; }
  .js .ar.R .tx { text-align: right; }
  /* §5 rule 3's centre lane, 2026-08-08. Also what fixes "the first image isnt
     near the text": a portrait's box is the whole stage, so its disc sits at
     x=717 while its left-aligned words started at x=72 — 640px apart, which reads
     as an uncentred picture when the picture is dead centre. layout.ts puts every
     portrait in lane 1, so this one rule centres both. */
  .js .ar.C .tx { text-align: center; }
  /* Positioned independently of the .tx flex flow — main.ts writes its rect
     every frame from frame()'s already-computed `art` box (§5 rule 3: art and
     text share one box, but never contend for the same space). */
  .js .ar img.art {
    position: absolute; left: 0; top: 0; display: block;
    object-fit: contain; pointer-events: none;
  }
  .js .ar .rule {
    display: block; height: 1px; width: 38px; background: currentColor;
    opacity: 0.42; margin-bottom: 11px;
  }
  .js .ar.R .rule { margin-left: auto; }
  .js .ar.C .rule { margin-inline: auto; }
  /* PROMINENCE, 2026-08-04. The dates, the description lines and the whispers
     read as "small and subtle" on a real screen (Dustin, at 1920). §8 fixes the
     COPY verbatim and none of it changes here — this is the other half: the
     lines were sitting at the BOTTOM of §11's 14–16px band, or under it, at
     0.5–0.76 opacity, over a field with no scrim behind them. §10 specifies a
     per-box servo scrim solved at build; it is not built yet, so until it is,
     the text carries its own halo the way the art does. The shadow is tighter
     and darker than the name's because small type needs a closer ground. */
  .js .ar .d {
    display: block; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    opacity: 0.84; margin: 0 0 0.5em;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.55);
  }
  .js .ar .n {
    display: block; font-size: clamp(19px, 2.2vw, 30px); line-height: 1.12;
    letter-spacing: -0.02em; font-weight: 650; margin: 0;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.4);
  }
  /* 14–16px is §11's stated band for "subject label + one line". This used to
     top out at 14.5, i.e. the floor of the band on every desktop; it now spans
     the band properly — 16px at 1440 and up, 14px on a phone. layout.ts's
     `typeScale` carries the same three numbers and MUST be changed with it, or
     the collision gate models a page that does not exist. */
  .js .ar .s {
    display: block; font-size: clamp(14px, 1.15vw, 16px); line-height: 1.5;
    opacity: 0.92; margin: 0.55em 0 0;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.55);
  }
  /* WHY THE PICTURE LOOKS LIKE THAT (Dustin, 2026-08-08). Set in the SAME
     metrics as the description line — `layout.ts`'s `typeScale` reuses the
     `line` spec for it, so there is no fourth number to keep in sync — and
     separated from it by a wider gap and less opacity instead. Making it
     smaller is the mistake §11's 2026-08-04 prominence fix already undid once,
     and this is the half a visitor most needs to read. It survives on a phone
     where `.s` does not: the phone has no other prose. */
  .js .ar .w {
    display: block; font-size: clamp(14px, 1.15vw, 16px); line-height: 1.5;
    opacity: 0.78; margin: 0.75em 0 0;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.55);
  }
  /* An inhabitant is quieter — an arrival, not a milestone. No tick, either.
     Quieter is a RATIO to the milestone, not a licence to go under the band:
     the line was 12px/0.62, which is below §11 outright. */
  .js .ar.I .rule { display: none; }
  .js .ar.I .n { font-size: clamp(14px, 1.3vw, 18px); font-weight: 600; letter-spacing: -0.008em; }
  .js .ar.I .d { font-size: 9.5px; opacity: 0.72; margin-bottom: 0.3em; }
  .js .ar.I .s { font-size: 13.5px; opacity: 0.82; }
  .js .ar.I .w { font-size: 13.5px; opacity: 0.7; }
  /* A field whisper: one line in its own band. No art, no card, no tick. */
  .js .ar.F { align-items: center; justify-content: center; }
  .js .ar.F .tx { text-align: center; }
  .js .ar.F .n {
    font-size: clamp(11px, 1.1vw, 13px); font-weight: 500; letter-spacing: 0.26em;
    text-transform: uppercase; opacity: 0.84;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.55);
  }
  /* layout.ts decides this, not a media query — so the gate and the DOM agree by
     construction. The line is enrichment, and it is what goes when a box is short. */
  .js .ar.no-line .s { display: none; }
  .js .ar.no-why .w { display: none; }

  /* ---------- the intro: a held frame ---------- */
  /* `safe` centring, not plain centring. At an enlarged text scale this block is
     taller than the box that holds it, and the SPEC default for a centred
     overflow is "unsafe" — spill off both ends, which loses the wordmark before
     anyone has read it. Chromium already clamps the start edge here (measured
     2026-08-07: identical geometry either way), so this changes nothing today;
     it is written down so the guarantee does not depend on that being true of
     every engine. No effect at any scale where the frame fits. */
  .js #intro {
    position: fixed; inset: 0; z-index: 4; display: grid; place-items: safe center;
    pointer-events: none; padding: 6vw;
  }
  #intro .in { max-width: 30rem; }
  #intro .wordmark {
    margin: 0; font-size: clamp(30px, 6.4vw, 62px); font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; line-height: 1;
  }
  #intro .thesis { margin: 1.4em 0 0; font-size: clamp(14px, 1.6vw, 18px); opacity: 0.92; }
  #intro .facts {
    list-style: none; margin: 2.1em 0 0; padding: 0; display: grid; gap: 0.45em;
    font-size: clamp(13px, 1.4vw, 16px); opacity: 0.82;
  }
  #intro .scroll {
    margin: 2.4em 0 0; font-size: 10px; letter-spacing: 0.34em;
    text-transform: uppercase; opacity: 0.45;
  }

  /* ---------- the clock: a reserved zone, and its footprint IS the budget ---------- */
  .js #hud {
    position: fixed; z-index: 3; pointer-events: none;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.5);
  }
  #hud p { margin: 0; }
  /* 74 → 46 (2026-08-07, his call). The clock is ambient — it changes ~460
     times over the scroll and is never the thing being read — and at 72 px on a
     1440 screen the HUD stack ran ~310 px, a third of the height. `hudHeight`'s
     `clockSize` mirrors this clamp; the two are one number in two files. */
  #hud-clock { display: block; }
  #hud-num {
    display: block; font-size: clamp(26px, 3.2vw, 46px); font-weight: 700;
    letter-spacing: -0.035em; line-height: 0.94;
  }
  /* The unit is a label, not a reading: it changes THREE times in 115,000 px,
     at `clockReading`'s rungs — billions, millions, thousands, then the present
     (2026-08-09; it changed once before the lower two rungs existed). Sized and
     tracked like the era beneath it, a step brighter so the pair reads as one
     sentence. */
  #hud-unit {
    display: block; font-size: clamp(10px, 1.05vw, 12.5px); font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.55;
    margin-top: 0.5em;
  }
  /* 0.8em → 1.5em, 2026-08-07. The unit label under the number is small tracked
     uppercase and so is this, and at the old gap the two read as one block:
     "BILLION YEARS AGO / HADEAN". The unit belongs to the number; the era is its
     own fact, and the space is what says so. */
  #hud-era {
    font-size: clamp(11px, 1.2vw, 14px); font-weight: 600; letter-spacing: 0.22em;
    text-transform: uppercase; opacity: 0.92; margin-top: 1.5em;
  }
  /* The `Modelled` block (moon · day) and its rule were cut 2026-08-07. The
     phone never showed them, and the Moon fact still reaches every visitor as
     the 4,450 Ma whisper. */
  #hud .rate, #hud-years {
    font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    opacity: 0.5; line-height: 1.8;
  }
  /* The rule used to open this gap. `hudHeight` prices it as ONE readout's own
     margin, so it is expressed in that element's em and nowhere else — and it
     belongs to whichever of the two comes first, which since 2026-08-09 is the
     years count rather than the rate. */
  #hud #hud-years { margin-top: 1.3em; }
  /* RULING F, 2026-08-05 — the lean HUD: clock · era, and nothing under them.
     A phone at 200% wraps all four lines into 343.7px against a 240px zone, and
     these two are what the stage can afford to lose. NOT a media query: a
     text-only zoom moves none of them (§10), so main.ts writes the class from
     layout.ts's `hudLean()` and this rule stays unconditional. */
  #hud.lean .rate, #hud.lean #hud-years { display: none; }

  /* ---------- the true-scale bar: one object, 4.60 Ga to the last frame ---------- */
  .js #bar { position: fixed; z-index: 3; pointer-events: none; }
  #bar i { position: absolute; display: block; }
  #bar .track { inset: 0; background: currentColor; opacity: 0.16; border-radius: 2px; }
  #bar .fill {
    inset: 0; background: currentColor; opacity: 0.55; border-radius: 2px;
    transform-origin: top; transform: scaleY(0);
  }
  #bar .head { left: -7px; width: 18px; height: 2px; background: currentColor; top: 0; }
  #bar .tick { left: -3px; width: 10px; height: 1px; background: currentColor; opacity: 0.7; }
  /* The caption runs VERTICALLY so it stays inside its own zone instead of
     reaching left into the stage. */
  #bar .cap {
    position: absolute; right: 14px; top: 0; writing-mode: vertical-rl;
    font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.45;
    white-space: nowrap;
  }

  /* ---------- the Boring Billion plate ---------- */
  /* §6: "centred in the stage box" — never the viewport. Positioned from
     Z.plate in main.ts, not inset:0, so it cannot reach the clock or scale
     zones (§5 rule 1) and is swept by gate-collision.ts. z-index 1, BELOW
     main's arrivals (z-index 2): §6 says the four real arrivals still render
     on top of it. */
  /* RULING G, 2026-08-06 — the box is solved to the words (`plateBox`), so the
     words are placed against the box rather than left to a grid.

     `padding: 8vw` is GONE, and it was not cosmetic: under `border-box` it floored
     the box at 230.4 px against a modelled 209.4 px at 1440×900/200 %, so `#plate`
     reported a rect that was not what was on the glass — and the box itself then
     entered the clock zone. `display: grid; place-items: center` is gone with it:
     an `auto` row track grows to its content, so centring had nothing to centre
     and every pixel of overflow ran downward into the clock. Absolute centring on
     the box cannot do that whatever the copy does.

     `--plate-k` is `1 / textScale` (`Zones.plateCopy.writeScale`), and `.in`'s
     width is written at `measure × textScale`: the block lays out at the enlarged
     size in a proportionally wider measure — so the line breaks are identical —
     and is then divided back down. Same divide as `Fan.writeScale`, same reason. */
  .js #plate {
    position: fixed; z-index: 1;
    pointer-events: none; opacity: 0; text-align: center;
  }
  .js #plate .in {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(var(--plate-k, 1));
  }
  /* Ruling G's one rung: at 1440×900 with 200 % text the held-at-100 % copy still
     will not fit the room the clock leaves, and the counter is what goes. */
  .js #plate.lean .cnt { display: none; }
  #plate p { margin: 0; }
  #plate .kicker {
    font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; opacity: 0.5;
    margin-bottom: 1.4em;
  }
  #plate .t {
    font-size: clamp(26px, 4.6vw, 54px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.02;
  }
  #plate .sub { font-size: clamp(12px, 1.3vw, 15px); opacity: 0.72; margin-top: 0.7em; }
  #plate .body { font-size: clamp(13px, 1.4vw, 16px); opacity: 0.88; line-height: 1.7; margin-top: 1.6em; }
  #plate .cnt { margin-top: 2.4em; display: grid; gap: 0.5em; }
  #plate .cnt b { font-size: clamp(15px, 1.9vw, 22px); font-weight: 650; }
  #plate .cnt span {
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; opacity: 0.45;
  }

  /* ---------- the finale ---------- */
  .js #finale {
    position: fixed; inset: 0; z-index: 5; max-width: none; margin: 0; padding: 0;
    pointer-events: none; opacity: 0; visibility: hidden;
  }
  .js #finale.live { opacity: 1; visibility: visible; }
  .js #leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .js #finale ol { list-style: none; margin: 0; padding: 0; }
  .js #finale li {
    position: absolute; left: 0; text-align: right; white-space: nowrap; opacity: 0;
  }
  .js #finale li a {
    display: inline-block; color: inherit; text-decoration: none; pointer-events: auto;
    padding: 1px 0 1px 7px; border-radius: 3px;
  }
  .js #finale li a:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
  #finale .fd { opacity: 0.7; margin-right: 0.9em; letter-spacing: 0.04em; }
  #finale .fn { font-weight: 500; letter-spacing: -0.004em; }
  /* The withheld ten: amber, below the seam, pointing at a pixel with no tick. */
  #finale li.ten .fd, #finale li.ten .fn { color: #ffd9a0; }
  #finale li.ten .fn { font-weight: 600; }
  .js #seam-caption {
    position: absolute; left: 0; margin: 0; text-align: right; white-space: nowrap;
    letter-spacing: 0.24em; text-transform: uppercase; color: #ffd9a0; opacity: 0;
    line-height: 1.25;
  }
  #closing-block p { margin: 0; }
  #closing-block .closing { font-size: clamp(14px, 1.5vw, 19px); line-height: 1.55; }
  #closing-block .epilogue { font-size: 13px; line-height: 1.6; margin-top: 1.5em; }
  /* `↑ again` lives in the plate's top slot, not in the closing block — see the
     `.ptop` rule below for why. `fan()`'s `againSpec` is the model of this type. */
  #blip-plate .again {
    display: inline-block; margin: 0; font-size: 10px; letter-spacing: 0.28em;
    text-transform: uppercase; color: inherit; text-decoration: none;
    border-bottom: 1px solid currentColor; padding-bottom: 3px; pointer-events: auto;
  }

  /* ---------- the flood: the record, heaped (design §4) ---------- */
  /* Without JS there is no geometry to heap fifty prints into, and the document's
     job is the facts — which the plate's own words carry in full. */
  #blip { display: none; }
  /* `overflow: hidden` IS §4 consequence 2: the fields deliberately run off the
     top, bottom and left by half a cell, and the frame is what cuts them, so the
     mass reads as MORE THAN FITS rather than as a composition. It never runs off
     the right — `blip()` stops it clear of the bar's reserved zone. */
  .js #blip { display: block; position: absolute; inset: 0; overflow: hidden; }
  /* One print. `blip()` writes the rect and the rotation in the resize path;
     nothing but opacity is written in the frame.

     THE POLAROID CARD — 2026-08-07, Dustin's ruling: the heap read as a flat
     contact sheet, not a stack of prints. `box-sizing: border-box` is the whole
     trick — the border and the deeper bottom margin eat INTO the rect `blip()`
     already solved and cleared, so the card reads as a physical print without
     moving a single pixel of the footprint the collision gate reasons about.
     `--paper` because the frame is the same warm stock the rest of the page is
     set on, not a stark print-shop white. The shadow is what lifts a print off
     the ones under it — without it the "overlap" reads as clipping, not a stack. */
  .js #blip .bc {
    position: absolute; left: 0; top: 0; opacity: 0; object-fit: cover;
    transform-origin: 50% 50%;
    box-sizing: border-box;
    background: var(--paper);
    border: clamp(2px, 0.3vw, 5px) solid var(--paper);
    border-bottom-width: clamp(7px, 1.4vw, 18px);
    box-shadow: 0 clamp(2px, 0.5vw, 6px) clamp(6px, 1.2vw, 16px) rgba(0, 0, 0, 0.45);
  }
  .js #blip-bracket {
    position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible;
    opacity: 0; color: #ffd9a0;
  }
  #blip-bracket line { stroke: currentColor; stroke-width: 1; }

  /* ---------- the plate: the band the flood was solved around (design §6) ----------
     EVERY number below is `blipBandHeight()` in layout.ts, which solves the band's
     height from these exact gaps and type sizes. Changing one here without changing
     it there leaves the solved band and the rendered words describing different
     text — which is the whole reason the copy moved into `timeline.json`.

     The gaps are `em` against the type they separate, which is `PLATE_GAPS`
     verbatim: 1.0 of the kicker, 0.17 of the title, 0.55 of the line, and 1.05 of
     the line as the band's own clear space from the heap. The plate carries the
     LINE's size so the two gaps written against it resolve correctly. */
  .js #blip-plate {
    position: absolute; display: flex; flex-direction: column; align-items: center;
    justify-content: center; text-align: center; pointer-events: none;
    font-size: clamp(14px, 1.5vw, 19px);
    padding: 1.05em 0; /* PLATE_GAPS.pad, both ends */
  }
  /* `flex: none`, and it is load-bearing. Any overflow of the content box is
     absorbed entirely by the one shrinkable child — every text child is floored at
     its own min-content height, so the 1px rule was the only thing that could
     give, and it rendered at 0 until this was added. */
  .js #blip-plate > * { flex: none; }
  .js #blip-plate .pk, .js #blip-plate .pt, .js #blip-plate .pr, .js #blip-plate .again { opacity: 0; }
  /* The kicker's slot, holding the kicker and `↑ again` stacked in one cell: its
     height is the taller of the two and does not change when they swap. */
  .js #blip-plate .ptop { display: grid; }
  .js #blip-plate .ptop > * { grid-area: 1 / 1; justify-self: center; }
  #blip-plate .ptop {
    margin: 0 0 1em; font-size: clamp(10px, 0.8vw, 12px); /* PLATE_GAPS.kicker */
  }
  /* main.ts writes the opacity of every part: they arrive in sequence, and each
     one's resting value is folded into that write rather than split across two
     files. */
  #blip-plate .pk {
    margin: 0; font-size: inherit; letter-spacing: 0.28em; text-transform: uppercase;
  }
  /* The site's punchline set as a title. The FLOOR is the constant that matters:
     a 16px punchline is not a smaller version of it. */
  #blip-plate .pt {
    margin: 0 0 0.17em; max-width: 92%; font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.02; letter-spacing: -0.02em; font-weight: 700; text-transform: uppercase;
  }
  #blip-plate .pr {
    margin: 0 0 0.55em; border: 0; width: 88px; height: 1px; background: #ffd9a0;
  }
  /* The closing line's own measure, `blipBandHeight`'s `lineW` verbatim. */
  .js #closing-block {
    position: static; display: grid; width: min(470px, 62%); margin: 0;
  }
  /* The line and the epilogue share ONE slot, so the epilogue costs the band no
     height it was not solved for. They never occupy it at once — sequential,
     never a crossfade, the same ruling §9 staging rule 3 already makes. */
  .js #closing-block .closing, .js #closing-block .epilogue { grid-area: 1 / 1; opacity: 0; }
  .js #closing-block .epilogue { margin-top: 0; }

  /* The document is one viewport taller than the scroll: without a pad the last
     beats of the finale are unreachable on every device. lvh, not vh. */
  .js .spacer { width: 1px; height: calc(var(--total) + 100lvh); }

  /* 759.98, not 760: the breakpoint must agree with layout.ts's MOBILE_BELOW, or
     the collision gate is measuring a page that does not exist. */
  @media (max-width: 759.98px) {
    #hud-num { font-size: clamp(22px, 7.6vw, 30px); }
    /* `blipBandHeight`'s `lineW` on the mobile branch — a phone column has no
       room to hold the sentence to a 62% measure. */
    .js #closing-block { width: min(470px, 92%); }
  }

  /* ── the dustincoledata signature ──────────────────────────────────────────
     The same mark every project wears, inverted for a near-black sky. `right`
     clears the true-scale bar; it never sits on top of it. Quiet at rest, since
     the page is the instrument and this is only the byline. */
  .dcd-mark {
    position: fixed;
    right: max(56px, calc(env(safe-area-inset-right, 0px) + 56px));
    bottom: max(18px, env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 13px 7px 11px; border-radius: 999px;
    background: rgba(5, 7, 10, 0.66);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border: 1px solid rgba(244, 241, 234, 0.16);
    text-decoration: none; line-height: 1; opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .dcd-mark:hover { opacity: 1; transform: translateY(-1px); border-color: rgba(138, 160, 255, 0.5); }
  .dcd-mark:focus-visible { outline: 2px solid #8aa0ff; outline-offset: 2px; }
  /* The letters take the page's ink; the period stays brand blue on every site —
     it is the one part of the mark that never localises. */
  .dcd-mark-logo { height: 13px; width: 24.7px; flex: none; display: block; color: var(--paper); }
  .dcd-mark-dot { fill: #8aa0ff; }
  .dcd-mark-rule { width: 1px; height: 13px; flex: none; background: rgba(244, 241, 234, 0.2); }
  .dcd-mark-words { display: inline-flex; align-items: baseline; gap: 7px; }
  .dcd-mark-name {
    font-family: 'Archivo', -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600; font-size: 13px; letter-spacing: -0.01em; color: var(--paper);
  }
  .dcd-mark-suffix {
    font-family: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', Menlo, monospace;
    font-weight: 500; font-size: 9px; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(244, 241, 234, 0.6);
  }
  @media print { .dcd-mark { display: none; } }

  /* Phone: the clock fills the lower half and the bar is closer in, so the pill
     drops its words and rides as the dc. monogram. aria-label still says it all. */
  @media (max-width: 520px) {
    .dcd-mark { padding: 8px; gap: 0; right: max(40px, calc(env(safe-area-inset-right, 0px) + 40px)); }
    .dcd-mark-rule, .dcd-mark-words { display: none; }
  }

  /* Nothing on this page starts moving on its own, so SC 2.2.2 does not apply and
     no toggle is added. Reduced motion still removes the glide and the parallax —
     never the distance, and never the fades, which have no vector. */
  @media (prefers-reduced-motion: reduce) {
    .js .ar .tx { transform: none !important; }
    .dcd-mark { transition: none; }
    .dcd-mark:hover { transform: none; }
  }
</style>
